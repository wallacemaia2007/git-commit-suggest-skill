{
  "name": "git-commit-suggest",
  "version": "1.2.1",
  "description": "Configurable Conventional Commits suggestion skill for AI agents. Types stay in English, summary and details follow your config language.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "generate:config-docs": "node scripts/generate-config-docs.mjs",
    "config": "node skills/git-commit-suggest/scripts/configure.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "git-commit-suggest": "./bin/cli.js"
  },
  "files": [
    "bin",
    "skills/git-commit-suggest/SKILL.md",
    "skills/git-commit-suggest/config.example.json",
    "skills/git-commit-suggest/references",
    "AGENTS.md",
    "CLAUDE.md",
    "skills/git-commit-suggest/scripts",
    ".claude-plugin",
    ".codex-plugin",
    ".codex-marketplace",
    ".agents",
    "docs",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    ".gitignore",
    "tests"
  ],
  "keywords": [
    "git",
    "commit",
    "conventional-commits",
    "ai-skill",
    "claude-code",
    "codex",
    "cursor",
    "continue",
    "roocode",
    "opencode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallacemaia2007/git-commit-suggest-skill.git"
  },
  "bugs": {
    "url": "https://github.com/wallacemaia2007/git-commit-suggest-skill/issues"
  },
  "homepage": "https://github.com/wallacemaia2007/git-commit-suggest-skill#readme"
}
